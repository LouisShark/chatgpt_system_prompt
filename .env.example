# Supermemory API key
# Obtain from: https://console.supermemory.ai
# Copy this file to .env and fill in your actual key.
# .env is gitignored and must NEVER be committed.
SUPERMEMORY_API_KEY=your_api_key_here

# Optional: restrict graveyard audits to these directories (colon-separated on Unix,
# semicolon-separated on Windows).
# PROJECT_AUDIT_ROOTS=/path/to/projects
